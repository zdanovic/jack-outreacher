###############################
# Telegram Accounts
###############################
# Comma-separated list of account IDs (lowercase/underscore recommended).
# Example: ACCOUNTS=main1,main2
ACCOUNTS=demo1,demo2

# For each account ID suffix, provide API credentials, phone, and session name.
# Session name is the path to your Telethon session file (created on login via UI/API).
demo1_API_ID=123456
demo1_API_HASH=your_api_hash_here
demo1_PHONE=+10000000000
demo1_SESSION=./sessions/demo1.session

demo2_API_ID=123457
demo2_API_HASH=your_api_hash_here
demo2_PHONE=+10000000001
demo2_SESSION=./sessions/demo2.session

###############################
# OpenRouter / AI
###############################
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_REFERER=https://yourdomain.com
OPENROUTER_X_TITLE=Telegram Orchestrator
# Privacy headers to request no retention/training:
OPENROUTER_DO_NOT_STORE=1
OPENROUTER_PRIVACY_MODE=high

# Message retention (days); set 0 to disable pruning.
MESSAGE_RETENTION_DAYS=90

# Optional encryption key for stored message bodies (Fernet-derived)
DATA_ENCRYPTION_KEY=change_this_to_a_strong_secret

###############################
# Auth / RBAC for UI/API
###############################
# Required to protect UI/API. If empty, API/UI run open (dev only).
AUTH_SHARED_SECRET=super_secret_shared_key
# Exact emails allowed for admin and client roles (comma-separated)
AUTH_ALLOWED_ADMIN_EMAILS=you@company.com,second.admin@company.com
AUTH_ALLOWED_CLIENT_EMAILS=client@client.com
# Optional allowed domains (comma-separated). If empty, any domain allowed.
AUTH_ALLOWED_EMAIL_DOMAINS=company.com,client.com
# Lifetimes (seconds)
AUTH_CODE_TTL_SECONDS=900
AUTH_TOKEN_TTL_SECONDS=86400
# Passwordless: allow login by email only (domain/allowlists still enforced)
AUTH_PASSWORDLESS=false
# Optional self-hosted OIDC (enables OAuth-style login in addition to codes)
OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:8080/realms/internal
OIDC_AUDIENCE=tg-orchestrator-ui
# If not set, JWKS URL is derived from OIDC_ISSUER/.well-known/jwks.json
OIDC_JWKS_URL=http://keycloak:8080/realms/internal/protocol/openid-connect/certs
# Auth endpoint (UI adds code+PKCE params automatically)
OIDC_AUTH_URL=http://localhost:8080/realms/internal/protocol/openid-connect/auth
OIDC_CLIENT_ID=tg-orchestrator-ui
OIDC_REDIRECT_URI=https://jackoutreacher.org/auth/callback

###############################
# Logging / Misc
###############################
ORCHESTRATOR_LOG_LEVEL=INFO

# Paths:
# - data/orchestrator_state.db      (state DB)
# - data/events.log.tsv             (event log)
# - data/leads_strategy_1.csv       (input leads; optional)
# - data/warmup_channels.txt        (extra warmup channels)
# - data/warmup_users.txt           (extra warmup users/bots)

# To generate a login code for an email:
#   python -m src.app.auth --email you@company.com
